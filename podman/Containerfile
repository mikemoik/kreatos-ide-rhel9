# kide in a RHEL9-compatible container — no install on the host, only podman.
# The base image and its repo setup are not in this file: podman/base.conf
# (BASE=…, default Rocky Linux 9; CONF_DIR=…, default podman/conf with
# repos.sh (default: CRB + EPEL, standing in for the RHEL9 target's own dnf
# repos), ubi.repo, pip.conf, uv.toml, pip-server.crt; KIDE_USER/KIDE_UID/KIDE_GID, the
# user the image runs as). Replace those for another base; this file stays as
# it is.
# Build from the repo root (dnf needs the repos; build.sh itself runs offline):
#   podman build --build-arg-file podman/base.conf -t kide -f podman/Containerfile .
# or without a checkout, straight from GitHub (the default base, no arg file):
#   podman build --build-arg BASE=docker.io/rockylinux/rockylinux:9 --build-arg CONF_DIR=podman/conf --build-arg KIDE_USER=default --build-arg KIDE_UID=1001 --build-arg KIDE_GID=1001 --build-arg PIP_INDEX_URL=https://pypi.org/simple -t kide -f podman/Containerfile https://github.com/kreatos/kreatos-ide-rhel9.git
# Every step that installs or writes system files runs as root (USER root, also
# when the base image defaults to another user); the image runs as KIDE_USER.
# Start it with podman/start.sh [--shell] [FILE…], which runs rootless podman,
# mapping you on the host to that user, so files in the mounted ~/workspace
# stay yours:
#   podman run --rm -it --userns=keep-id:uid=1001,gid=1001 -v "$HOME/workspace:/workspace:Z" -v kide-data:/var/lib/kide kide [FILE…]
# A shell (fish, with the IDE's aliases from fish/):
#   podman run --rm -it --userns=keep-id:uid=1001,gid=1001 -v "$HOME/workspace:/workspace:Z" -v kide-data:/var/lib/kide --entrypoint fish kide
# See podman/README.md.

ARG BASE
# CONF_DIR (podman/base.conf): repos.sh, ubi.repo, pip.conf, uv.toml, pip-server.crt
ARG CONF_DIR

# --- build: the RHEL9 toolchain + build.sh (as test/Containerfile) -----------
FROM $BASE AS build
USER root
ARG CONF_DIR
COPY $CONF_DIR/ubi.repo /etc/yum.repos.d/ubi.repo
COPY $CONF_DIR/repos.sh /tmp/repos.sh
RUN /tmp/repos.sh && dnf -y install gcc make cmake python3 rust-toolset golang findutils diffutils \
        git-core file gcc-c++ clang-tools-extra gdb lldb libevent-devel ncurses-devel \
        perl perl-Dumpvalue bzip2 \
    && dnf clean all
# Two layers, so that a config-only change rebuilds in seconds:
# 1. compile: only what the binaries are built from (vendor/, dist/,
#    manifest/, scripts/, build.sh). podman reuses this layer until one of them changes.
#    The config dirs are empty here; build.sh still copies them.
COPY build.sh /src/
COPY dist /src/dist
COPY manifest /src/manifest
COPY scripts /src/scripts
COPY vendor /src/vendor
RUN mkdir -p /src/config /src/yazi /src/fish && /src/build.sh /opt/kide
# 2. config: nvim, yazi and fish config, plugins, launcher (build.sh --no-build)
COPY config /src/config
COPY yazi /src/yazi
COPY fish /src/fish
RUN /src/build.sh --no-build /opt/kide

# --- runtime: kide + the RHEL packages it uses, no Rust/Go toolchain ---------
FROM $BASE
# Everything up to the USER line at the end runs as root.
USER root
# python3 (kide-python, debugpy), git (gitsigns, lazygit), file (yazi), and the
# C/C++ tools kide uses from RHEL (clangd/clang-format/clang-tidy, gdb, lldb-dap).
# tmux is built by build.sh; its libevent and ncurses-libs are in the base image.
# For C/C++ projects: perl + perl-Dumpvalue (MPC, ACE+TAO/OpenDDS tooling),
# Python 3.12 with numpy and pybind11, opencv, glew, glfw. shadow-utils
# (useradd/usermod) for KIDE_USER below.
ARG CONF_DIR
COPY $CONF_DIR/ubi.repo /etc/yum.repos.d/ubi.repo
COPY $CONF_DIR/repos.sh /tmp/repos.sh
RUN /tmp/repos.sh && dnf -y install python3 git-core file findutils diffutils shadow-utils \
        gcc gcc-c++ make cmake clang-tools-extra gdb lldb \
        perl perl-Dumpvalue python3.12 python3.12-pip python3.12-numpy \
        python3.12-pybind11 python3.12-pybind11-devel \
        opencv-devel glew-devel glfw glfw-devel \
    && dnf clean all
# pip-server.crt is the pip server's certificate (or the company CA that signed
# it; PEM, no private key; the repo has a dummy). It goes into the system trust
# store, so every user and tool trusts the pip repo, at build time and runtime:
# pip through cert = the system bundle (/etc/pip.conf), uv through
# system-certs = true (/etc/uv/uv.toml).
COPY $CONF_DIR/pip-server.crt /tmp/pip-server.crt
RUN set -e; \
    grep -q -- '-----BEGIN CERTIFICATE-----' /tmp/pip-server.crt \
      || { echo "pip-server.crt must be a PEM certificate (BEGIN CERTIFICATE)" >&2; exit 1; }; \
    ! grep -q 'PRIVATE KEY' /tmp/pip-server.crt \
      || { echo "pip-server.crt must not contain a private key (it goes into the trust store)" >&2; exit 1; }; \
    sed -n '/-----BEGIN CERTIFICATE-----/,/-----END CERTIFICATE-----/p' /tmp/pip-server.crt \
      >/etc/pki/ca-trust/source/anchors/pip-server.crt; \
    chmod 644 /etc/pki/ca-trust/source/anchors/pip-server.crt; \
    rm /tmp/pip-server.crt; \
    update-ca-trust
# pip and uv config, system-wide for every user (uv does not read pip.conf).
# Both are templates: @PIP_INDEX_URL@ becomes PIP_INDEX_URL from
# podman/base.conf (the pip package repo).
ARG PIP_INDEX_URL
COPY $CONF_DIR/pip.conf /etc/pip.conf
COPY $CONF_DIR/uv.toml /etc/uv/uv.toml
RUN set -e; \
    [ -n "$PIP_INDEX_URL" ] || { echo "PIP_INDEX_URL is not set (podman/base.conf)" >&2; exit 1; }; \
    url=$(printf '%s' "$PIP_INDEX_URL" | sed 's/[&|\\]/\\&/g'); \
    sed -i "s|@PIP_INDEX_URL@|$url|g" /etc/pip.conf /etc/uv/uv.toml; \
    ! grep -n '@[A-Z_]*@' /etc/pip.conf /etc/uv/uv.toml \
      || { echo "unreplaced placeholder in pip.conf/uv.toml (above)" >&2; exit 1; }; \
    chmod 644 /etc/pip.conf /etc/uv/uv.toml; \
    echo "pip and uv use $PIP_INDEX_URL"
COPY --from=build /opt/kide /opt/kide
# the dynamic linker finds ACE/TAO/OpenDDS (lib) and onnxruntime (lib64) for
# every program in the container, also ones built without an RPATH
RUN printf '/opt/kide/lib\n/opt/kide/lib64\n' >/etc/ld.so.conf.d/kide.conf && ldconfig
# git trusts every repo (/etc/gitconfig): mounted projects are owned by whatever
# uid the user namespace maps the host owner to, which often isn't the
# container user (no or another --userns, files of another host user, --user
# root), and git then refuses with "dubious ownership". The check guards
# against other users' repos on a shared machine, which a container doesn't have.
RUN git config --system --add safe.directory '*'
# what PREFIX/bashrc does on an install
ENV PATH=/opt/kide/bin:$PATH \
    YAZI_CONFIG_HOME=/opt/kide/share/kreatos-ide/yazi
# fish is the default shell: $SHELL (nvim's :terminal and terminal windows,
# lazygit, yazi) and the login shell of KIDE_USER and root. Its config is the
# bundled one (/opt/kide/share/kreatos-ide/fish: PATH, YAZI_CONFIG_HOME,
# aliases); bash stays as a fallback (--entrypoint bash) and sets the same.
ENV SHELL=/opt/kide/bin/fish
RUN echo /opt/kide/bin/fish >>/etc/shells \
    && sed -i 's|^\(root:.*:\)/bin/bash$|\1/opt/kide/bin/fish|' /etc/passwd \
    && grep -q '^root:.*:/opt/kide/bin/fish$' /etc/passwd \
    && mkdir -p /root/.config/fish \
    && echo 'source /opt/kide/share/kreatos-ide/fish/config.fish' >/root/.config/fish/config.fish \
    && echo '. /opt/kide/bashrc' >>/root/.bashrc
# kide's data and state (nvim undo/shada/swap, fish history, lazygit and yazi
# state) live under /var/lib/kide instead of ~/.local, so the kide-data volume
# has the same mount point whatever KIDE_USER's home is.
ENV XDG_DATA_HOME=/var/lib/kide/share \
    XDG_STATE_HOME=/var/lib/kide/state
# KIDE_USER (podman/base.conf): the user the image runs as. Taken from the base
# image if it has it (e.g. "default" in Red Hat's application images),
# otherwise created with KIDE_UID/KIDE_GID. Gets fish as login shell and the
# fish and bash config (with ~/.local/bin, where its pip and uv go, on PATH),
# owns /var/lib/kide.
# /workspace is the WORKDIR, a plain directory owned by KIDE_USER: the mount
# point for the host's ~/workspace (podman run -v "$HOME/workspace:/workspace:Z").
# fish sources every *.fish in /workspace/.container/fish/ (on the host:
# ~/workspace/.container/fish/) last, in name order; none: nothing happens.
ARG KIDE_USER
ARG KIDE_UID
ARG KIDE_GID
RUN set -e; \
    if ! id -u "$KIDE_USER" >/dev/null 2>&1; then \
      getent group "$KIDE_GID" >/dev/null || groupadd -g "$KIDE_GID" "$KIDE_USER"; \
      useradd -m -u "$KIDE_UID" -g "$KIDE_GID" "$KIDE_USER"; \
    fi; \
    usermod -s /opt/kide/bin/fish "$KIDE_USER"; \
    home=$(getent passwd "$KIDE_USER" | cut -d: -f6); \
    group=$(id -g "$KIDE_USER"); \
    mkdir -p "$home/.config/fish" /var/lib/kide/share /var/lib/kide/state /workspace; \
    printf '%s\n' 'fish_add_path -g ~/.local/bin' 'source /opt/kide/share/kreatos-ide/fish/config.fish' \
      'for f in /workspace/.container/fish/*.fish; source $f; end' >"$home/.config/fish/config.fish"; \
    printf '%s\n' 'PATH="$HOME/.local/bin:$PATH"' '. /opt/kide/bashrc' >>"$home/.bashrc"; \
    chown "$KIDE_USER:$group" "$home" "$home/.bashrc"; \
    chown -R "$KIDE_USER:$group" "$home/.config" /workspace /var/lib/kide
USER $KIDE_USER
# as KIDE_USER: the newest pip and uv for Python 3.12 into its ~/.local
# (pip install --user, with /etc/pip.conf: company repo, trusted via pip-server.crt);
# root installs nothing with pip. /usr/bin/python3.12, the dnf one: a base
# image may put a venv's python first on PATH (e.g. /opt/app-root in Red Hat's
# Python images), and pip refuses --user inside a venv.
RUN /usr/bin/python3.12 -m pip install --user --no-cache-dir --upgrade pip uv
WORKDIR /workspace
ENTRYPOINT ["kide"]
