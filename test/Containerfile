# Clean RHEL9 with only packages from the RHEL repos. The build itself runs
# with --network=none (see test/run.sh).
FROM registry.access.redhat.com/ubi9/ubi:latest
# build toolchain
RUN dnf -y install gcc make cmake python3 rust-toolset golang findutils diffutils \
    && dnf clean all
# runtime: git (gitsigns); C/C++ development tools RHEL ships itself, used by
# kide instead of bundling them (clangd/clang-format/clang-tidy, gdb, lldb-dap)
RUN dnf -y install git-core gcc-c++ clang-tools-extra gdb lldb \
    && dnf clean all
