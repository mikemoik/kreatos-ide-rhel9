# Clean RHEL9 with only packages from the RHEL repos: the build toolchain plus
# git (runtime: gitsigns). The build itself runs with --network=none (see
# test/run.sh).
FROM registry.access.redhat.com/ubi9/ubi:latest
RUN dnf -y install gcc make cmake python3 git-core findutils diffutils \
    && dnf clean all
